rules_version = '2';

// Muser Firestore rules (see docs/MUSER_ARCHITECTURE.md §2 and docs/MUSER_DATABASE.md §12).
//
// Model: the app talks to the backend API for ALL business reads/writes. The backend
// uses the Admin SDK, which bypasses these rules. The only direct client access is the
// owner-scoped, READ-ONLY Activity listener. Everything else is denied to clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Recipient's Activity feed: read-only, owner only. Created by the backend in the
    // same transaction as the reaction; clients can never create, edit or delete rows.
    match /users/{uid}/activity/{reactionId} {
      allow get, list: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // Default deny: users, likes, songSignals, devices, playlists, friendships, shares,
    // reactions, profiles, usernames, catalog (artists/albums/songs/tags), outbox, ...
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
