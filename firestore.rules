rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------
    // 1. Music Catalog (Section 4 & 12)
    // Read: All authenticated users
    // Write: Denied to clients (Admin SDK / trusted import only)
    // -------------------------------------------------------------
    match /songs/{songId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /artists/{artistId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /albums/{albumId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /tags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 2. Identity & Usernames (Section 3 & 12)
    // Read: Authenticated scoped lookups
    // Write: Backend transactions only
    // -------------------------------------------------------------
    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /usernames/{normalizedUsername} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 3. Private User Settings & Subcollections (Section 3, 5, 8, 9 & 12)
    // -------------------------------------------------------------
    match /users/{uid} {
      // Owner only read; updates via backend use-case operations to protect shareEpoch & seeds
      allow read: if isOwner(uid);
      allow write: if false;

      // Canonical Liked collection: Owner can read; managed via likeSong/unlikeSong backend transactions
      match /likes/{songId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Private recommendation aggregates (telemetry): Owner read and rate-limited write
      match /songSignals/{songId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      // Received Activity rows: Recipient read; created strictly by backend sendHeart transaction
      match /activity/{reactionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Push registration devices: Owner read and write
      match /devices/{installationId} {
        allow read, write: if isOwner(uid);
      }
    }

    // -------------------------------------------------------------
    // 4. Custom Playlists & Items (Section 5 & 12)
    // All custom playlists are private to the owner
    // -------------------------------------------------------------
    match /playlists/{playlistId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      match /items/{songId} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/playlists/$(playlistId)).data.ownerId == request.auth.uid;
      }
    }

    // -------------------------------------------------------------
    // 5. Friendships (Section 6 & 12)
    // Read: Participants only
    // Write: Backend use cases only (enforces transactional transition logic)
    // -------------------------------------------------------------
    match /friendships/{pairId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 6. Shares (Section 7 & 12)
    // Read & Write: Backend only (live authorization, epoch checking & pagination)
    // -------------------------------------------------------------
    match /shares/{shareId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 7. Reactions (Section 8 & 12)
    // Read & Write: Backend only (creates reaction + Activity row atomically)
    // -------------------------------------------------------------
    match /reactions/{reactionId} {
      allow read, write: if false;
    }
  }
}

